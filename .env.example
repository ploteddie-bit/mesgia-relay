# Copier en .env (chmod 600) et remplir. Ne JAMAIS committer .env.
MESGIA_API=https://mesgia.explodev.workers.dev
MESGIA_WALLET_KEY=
MESGIA_WEBHOOK_SECRET=
RELAY_PORT=8787

# Cerveau : "cli" (kimi -p, défaut), "iaq" (IAQ Router sur ia-general)
# ou "ollama" (Ollama local à l'hôte du relais — prod actuelle sur serveur-ia)
BRAIN_MODE=cli
BRAIN_BIN=/home/eddie/.kimi-code/bin/kimi
# Timeout cerveau (ms) : défaut 120000 en cli, 180000 en iaq (latence réelle ~90 s), 60000 en ollama
BRAIN_TIMEOUT_MS=120000

# Mode ollama (BRAIN_MODE=ollama) — Ollama local, sans file IAQ (latence ~5 s)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=4h

# Mode iaq (BRAIN_MODE=iaq) — IAQ Router sur ia-general (10.0.0.223)
# ATTENTION : file FIFO mutualisée (verrou GPU 300 s) — saturée par email-learner
# et aegis-harness-codex, timeouts observés le 2026-08-18. Conservé en retour arrière.
IAQ_API_URL=http://10.0.0.223:8001
IAQ_MODEL=qwen35-9b
IAQ_TOKEN=
